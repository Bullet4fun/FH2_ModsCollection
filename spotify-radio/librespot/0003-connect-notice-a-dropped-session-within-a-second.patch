From 7ab9511fdf616c91d1bca95c357fb38654567dde Mon Sep 17 00:00:00 2001
From: Bullet4fun <68350015+Bullet4fun@users.noreply.github.com>
Date: Fri, 16 Oct 2026 14:06:21 +0300
Subject: [PATCH] connect: notice a dropped session within a second

The run loop only re-checked session.is_invalid() after some event fired, so after Spotify closed the connection it took minutes (2m13s in game) before spirc shut down and main reconnected. A 1s wake-up re-evaluates the loop condition.

---
 connect/src/spirc.rs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/connect/src/spirc.rs b/connect/src/spirc.rs
index 3f9a06f..1a2d456 100644
--- a/connect/src/spirc.rs
+++ b/connect/src/spirc.rs
@@ -512,6 +512,9 @@ impl SpircTask {
                         error!("could not dispatch player event: {e}");
                     }
                 },
+                // wake up regularly so the loop condition notices a dropped session within a
+                // second; otherwise it waited for the next event (minutes) before reconnecting
+                _ = sleep(Duration::from_secs(1)) => {},
                 _ = async { sleep(UPDATE_STATE_DELAY).await }, if self.update_state => {
                     self.update_state = false;
 
