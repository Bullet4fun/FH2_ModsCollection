From 6d3ff57a14575fbd3c83552327111bb178c43a8e Mon Sep 17 00:00:00 2001
From: Bullet4fun <68350015+Bullet4fun@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:28:35 +0300
Subject: [PATCH] main: sign in through the browser when there is no saved
 login

Finding the device on the local network fails while the Spotify desktop app holds the mDNS port, so a first start without cached credentials never showed up. With a system cache and no saved login, OAuth runs once and the login is saved.
---
 src/main.rs | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/main.rs b/src/main.rs
index d2e81a9..c6bb2b1 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -1232,6 +1232,10 @@ async fn get_setup() -> Setup {
         }
     };
 
+    // No saved login yet (the game mod's first start): sign in once through the browser. Finding
+    // the device on the local network fails while the Spotify desktop app holds the mDNS port.
+    let enable_oauth = enable_oauth || (credentials.is_none() && cache.is_some());
+
     let no_discovery_reason = if !cfg!(any(
         feature = "with-libmdns",
         feature = "with-dns-sd",
-- 
2.42.0.windows.2

