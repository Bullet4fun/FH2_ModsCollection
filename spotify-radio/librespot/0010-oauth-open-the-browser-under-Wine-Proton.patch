From a45019e61c688b9f7a0baa38970968ca2f8fb35c Mon Sep 17 00:00:00 2001
From: Bullet4fun <68350015+Bullet4fun@users.noreply.github.com>
Date: Fri, 23 Oct 2026 04:32:39 +0300
Subject: [PATCH] oauth: open the browser under Wine/Proton

Inside Steam's runtime container winebrowser finds no xdg-open, so no browser opened. Wine starts Linux programs directly: call steam-runtime-urlopen (or xdg-open) by its Z: path first; on Windows these paths don't exist and the stock opener runs.
---
 oauth/src/lib.rs | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/oauth/src/lib.rs b/oauth/src/lib.rs
index fa322bc..6a504f5 100644
--- a/oauth/src/lib.rs
+++ b/oauth/src/lib.rs
@@ -221,6 +221,23 @@ fn get_socket_address(redirect_uri: &str) -> Option<SocketAddr> {
     }
 }
 
+// Under Wine/Proton the stock route (winebrowser -> xdg-open) fails inside Steam's runtime
+// container, which has no xdg-open. Wine starts Linux programs directly, so call the container's
+// URL opener (or xdg-open outside the container) by its Z: path; on Windows these paths don't exist.
+fn open_browser(url: &str) {
+    for opener in [
+        r"Z:\usr\bin\steam-runtime-urlopen",
+        r"Z:\usr\bin\xdg-open",
+    ] {
+        if std::path::Path::new(opener).exists()
+            && std::process::Command::new(opener).arg(url).spawn().is_ok()
+        {
+            return;
+        }
+    }
+    open::that_in_background(url);
+}
+
 /// Struct that handle obtaining and refreshing access tokens.
 pub struct OAuthClient {
     scopes: Vec<String>,
@@ -248,10 +265,10 @@ impl OAuthClient {
             .url();
 
         if self.should_open_url {
-            open::that_in_background(auth_url.as_str());
+            open_browser(auth_url.as_str());
         }
-        // Not stdout: the pipe backend plays audio there. Under Wine/Proton no browser opens, so
-        // the link also goes to a file next to librespot, to open by hand on the same machine.
+        // Not stdout: the pipe backend plays audio there. If no browser opens, the link also goes
+        // to a file next to librespot, to open by hand on the same machine.
         eprintln!("Browse to: {auth_url}");
         if let Err(e) = std::fs::write("sign-in-link.txt", format!("{auth_url}\r\n")) {
             warn!("Could not write sign-in-link.txt: {e}");
-- 
